# Backend Ginkgo. Sao chep thanh .env o thu muc goc; khong chep vao mobile.
# Huong dan tung bien: docs/08-environment-setup.md
NODE_ENV=development
PORT=3000
# MariaDB Docker hien tai: port may tinh 3307 -> container 3306.
# Giu ten database healthycheck khi doi thuong hieu de dung du lieu hien co.
DATABASE_URL=mysql://healthycheck:local_only_change_me@127.0.0.1:3307/healthycheck
# Bat TLS khi ket noi database cloud. CA tuy chon la PEM voi newline that.
DATABASE_SSL=false
DATABASE_SSL_CA=
# Tu tao hai chuoi ngau nhien KHAC NHAU, toi thieu 32 ky tu. Khong dung mau nay.
JWT_SECRET=replace-with-at-least-32-random-characters
# Origin cua giao dien WEB, khong phai dia chi API. Nhieu origin cach nhau bang dau phay.
CORS_ORIGINS=http://localhost:8081
# dev: khong gui SMS that; twilio: can tai khoan va sender duoc phep gui.
SMS_PROVIDER=dev
DEV_OTP_ENABLED=true
DEV_OTP_CODE=123456
OTP_PEPPER=replace-with-another-32-character-secret
# Lay tu Twilio Console > Account SID/Auth Token (live credentials).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# So gui hoac Alphanumeric Sender ID DUOC PHE DUYET. Khong phai so nhan OTP.
# So +84 can kiem tra sender va template theo quy dinh Twilio Vietnam.
TWILIO_FROM=
# Tao API key cho project rieng tai platform.openai.com/api-keys.
# Khong dat key trong EXPO_PUBLIC_*. Vi du model ho tro Responses: gpt-4.1-mini.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
EXPO_PUBLIC_API_URL=
# Android device builds may set EXPO_PUBLIC_API_URL=http://<computer-lan-ip>:3000
# So luot / user / ngay UTC trong app, KHONG phai gioi han so tien USD.
AI_DAILY_LIMIT=20

# Database rieng cho integration test, ten bat buoc ket thuc bang _test.
TEST_DATABASE_URL=mysql://healthycheck:local_only_change_me@127.0.0.1:3307/healthycheck_test
# Tuy chon. Chi bat de tao tai khoan DEMO rieng; khong can cho nguoi dang ky thuong.
DEMO_SEED_ENABLED=false
DEMO_PHONE=+84900000001
# Tu dat mat khau demo >= 10 ky tu neu bat seed.
DEMO_PASSWORD=
