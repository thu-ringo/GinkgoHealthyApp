{
  "expo": {
    "name": "Ginkgo",
    "slug": "ginkgo",
    "scheme": [
      "ginkgo",
      "healthycheck"
    ],
    "icon": "./assets/ginkgo-icon.png",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.healthycheck.student"
    },
    "android": {
      "package": "com.healthycheck.student",
      "adaptiveIcon": {
        "foregroundImage": "./assets/ginkgo-adaptive.png",
        "monochromeImage": "./assets/ginkgo-adaptive.png",
        "backgroundColor": "#E8F3EA"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-sharing",
      "expo-status-bar",
      "expo-font"
    ],
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/ginkgo-favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "13cf43ec-3218-4168-a4dd-5ab8a0eedff5"
      }
    },
    "owner": "thuringo"
  }
}
