{
  "name": "healthycheck",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "api": "npm run dev -w apps/api",
    "mobile": "npm run start -w apps/mobile",
    "build": "npm run build -w apps/api",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w apps/api",
    "db:migrate": "npm run migrate -w apps/api",
    "db:status": "npm run migrate:status -w apps/api",
    "db:revert": "npm run migrate:revert -w apps/api",
    "seed:demo": "npm run seed:demo -w apps/api",
    "test:integration": "npm run test:integration -w apps/api",
    "lint": "expo lint"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "9.1.0"
  }
}
